<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. See backup_rules.xml: the identity moves with its recovery key, not backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="moodify_identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="moodify_identity.xml" />
    </device-transfer>
</data-extraction-rules>
