<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The identity seed is wrapped by a Keystore key that
     never leaves the phone, so a restored copy could not be opened anyway:
     identities move to a new phone with the 24-word recovery key instead. -->
<full-backup-content>
    <exclude domain="sharedpref" path="moodify_identity.xml" />
</full-backup-content>
