# Moodify Frontend — Environment Variables
# Copy this file to .env.local for local development
# Set these in Vercel Dashboard → Project → Settings → Environment Variables

# URL of your deployed Moodify backend server (Render / Railway etc.)
# Local default: http://127.0.0.1:8787
VITE_MOODIFY_SERVER_URL=https://your-moodify-server.onrender.com
