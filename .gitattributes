# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force these to always use LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary files — do not modify
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.lockb binary
